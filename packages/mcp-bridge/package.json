{
  "name": "@josharsh/webmcp-bridge",
  "version": "0.1.0",
  "description": "Expose webmcp-tools tools as a real MCP server — lets browser extensions, iframe agents, and devtools list and call the page's WebMCP tools over postMessage.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "webmcp-tools": "workspace:^"
  },
  "devDependencies": {
    "webmcp-tools": "workspace:*"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "bridge",
    "postmessage",
    "ai",
    "agents",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josharsh/webmcp-tools"
  },
  "publishConfig": {
    "access": "public"
  }
}
