{
  "name": "@webmcp-kit/vue",
  "version": "0.1.0",
  "description": "Vue 3 composables for webmcp-kit — register WebMCP tools tied to component lifecycle.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "webmcp-kit": "workspace:*"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "vue": "^3.5.13",
    "webmcp-kit": "workspace:*"
  },
  "keywords": [
    "webmcp",
    "vue",
    "composable",
    "model-context",
    "ai",
    "agents",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josharsh/webmcp-kit"
  }
}
