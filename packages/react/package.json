{
  "name": "@webmcp-kit/react",
  "version": "0.1.0",
  "description": "React hooks for webmcp-kit — register WebMCP (document.modelContext) tools from components with automatic cleanup and latest-props execution.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "webmcp-kit": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webmcp-kit": "workspace:*"
  },
  "keywords": [
    "webmcp",
    "model-context",
    "react",
    "hooks",
    "ai",
    "agents",
    "mcp",
    "browser",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josharsh/webmcp-kit"
  }
}
