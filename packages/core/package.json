{
  "name": "webmcp-tools",
  "version": "0.1.2",
  "description": "Typed, validated, ergonomic SDK for WebMCP (document.modelContext) — expose your site's functionality as tools AI agents can call.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/zod.js",
    "./dist/zod.cjs",
    "./dist/valibot.js",
    "./dist/valibot.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./valibot": {
      "import": {
        "types": "./dist/valibot.d.ts",
        "default": "./dist/valibot.js"
      },
      "require": {
        "types": "./dist/valibot.d.cts",
        "default": "./dist/valibot.cjs"
      }
    },
    "./ponyfill": {
      "import": {
        "types": "./dist/ponyfill.d.ts",
        "default": "./dist/ponyfill.js"
      },
      "require": {
        "types": "./dist/ponyfill.d.cts",
        "default": "./dist/ponyfill.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "zod": [
        "./dist/zod.d.ts"
      ],
      "valibot": [
        "./dist/valibot.d.ts"
      ],
      "ponyfill": [
        "./dist/ponyfill.d.ts"
      ],
      "devtools": [
        "./dist/devtools.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@valibot/to-json-schema": "^1.7.1",
    "valibot": "^1.4.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@valibot/to-json-schema": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@valibot/to-json-schema": "^1.7.1",
    "valibot": "^1.4.2",
    "zod": "^4.0.0"
  },
  "keywords": [
    "webmcp",
    "model-context",
    "ai",
    "agents",
    "mcp",
    "browser",
    "tools",
    "w3c"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josharsh/webmcp-tools"
  }
}
